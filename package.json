{
  "name": "rirekisho-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-manual-date.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview:worker": "npm run build && wrangler dev",
    "check": "npm run lint && npm run typecheck:test && npm run test:coverage && npm run build && npm run check:docs && npm run check:deploy && npm run check:security && npm run test:e2e:run",
    "check:deploy": "node scripts/check-deployment.mjs",
    "check:docs": "node scripts/check-doc-consistency.mjs",
    "check:security": "node scripts/check-security.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "serve:test": "node scripts/serve-dist.mjs",
    "security:sca": "npm audit --audit-level=moderate && npm audit --omit=dev --audit-level=moderate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:security": "npm run build && npm run check:deploy && npm run check:security && playwright test e2e/security.spec.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:watch": "vitest"
  },
  "dependencies": {
    "docx": "^9.9.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.139.0"
  }
}
